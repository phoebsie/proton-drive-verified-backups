#!/usr/bin/python3
"""Explicit opt-in unattended pass unlock; no passphrase in argv/env/logs."""
from pathlib import Path
import json
import os
import re
import subprocess
import sys


def main():
    os.umask(0o077)
    config = json.loads(Path(sys.argv[1]).read_text())
    env = {'PATH': '/usr/bin:/bin', 'HOME': config['home'], 'GNUPGHOME': config['gnupghome']}
    phrase = Path(config['passphrase_file'])
    if phrase.is_symlink() or phrase.stat().st_mode & 0o077 or phrase.stat().st_uid != os.geteuid():
        raise ValueError('private passphrase file required')
    grips = config['keygrips']
    if not grips or any(not re.fullmatch(r'[0-9A-Fa-f]{40}', grip) for grip in grips):
        raise ValueError('valid encryption keygrips required')
    # gpg-agent.conf must already contain the reviewed policy (see SETUP.md).
    agent = Path(config['gnupghome']) / 'gpg-agent.conf'
    lines = [line.strip() for line in agent.read_text().splitlines()
             if line.strip() and not line.lstrip().startswith('#')]
    for option, value in (('allow-preset-passphrase', ''), ('default-cache-ttl', '172800'),
                          ('max-cache-ttl', '172800')):
        matches = [line for line in lines if line.split()[0] == option]
        if matches != [(option + ' ' + value).strip()]:
            raise ValueError('agent cache policy not configured exactly')
    subprocess.run(['/usr/bin/gpg-connect-agent', '/bye'], env=env, check=True,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
    for grip in grips:
        with phrase.open('rb') as handle:
            subprocess.run([config['preset_binary'], '--preset', grip], stdin=handle, env=env,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True, timeout=30)
    subprocess.run(['/usr/bin/pass', 'show', config['pass_entry']], env=env,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True, timeout=30)


if __name__ == '__main__':
    try:
        main()
    except Exception:
        print('GPG preset or unattended decrypt failed', file=sys.stderr)
        sys.exit(1)
