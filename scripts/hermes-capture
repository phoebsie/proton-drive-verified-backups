#!/usr/bin/python3
"""Simple installed-Hermes native-full adapter; see ADAPTERS.md limitations."""
from pathlib import Path
import argparse
import os
import subprocess
import sys
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from dr.capture import validate_file
parser = argparse.ArgumentParser()
parser.add_argument('--binary', required=True)
parser.add_argument('--home', required=True)
parser.add_argument('output_dir')
args = parser.parse_args()
try:
    if not Path(args.binary).is_absolute() or not Path(args.home).is_absolute():
        raise ValueError('absolute paths required')
    output = Path(args.output_dir) / 'native-full.zip'
    env = {'PATH': '/usr/bin:/bin', 'HOME': os.environ.get('HOME', '/root'),
           'HERMES_HOME': args.home, 'LANG': 'C.UTF-8'}
    subprocess.run([args.binary, 'backup', '--output', str(output), '--keep', '0'],
                   env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                   timeout=1800, check=True)
    validate_file(output, 'zip')
except Exception:
    print('Hermes native full capture failed', file=sys.stderr)
    sys.exit(1)
